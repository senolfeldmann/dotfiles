# Cross-platform (macOS and Linuxbrew): CLI media tools as formulae so
# convert/mogrify and mkvmerge/mkvextract sit directly in PATH for scripting;
# a Flatpak would hide them behind `flatpak run --command=`.
brew "imagemagick"
# On macOS the mkvtoolnix-app cask below already symlinks the CLI tools
# into PATH; installing the formula too makes `brew link` conflict.
brew "mkvtoolnix" unless OS.mac?

if OS.mac?
    # Runtimes
    # app is native, but translating x86 Windows code needs rosetta
    # (native arm64 build announced for CrossOver 27, not shipped yet)
    cask "crossover"

    # Entertainment
    tap "playcover/playcover"
    cask "playcover/playcover/"

    # Multimedia
    cask "plex"
    cask "iina"
    cask "vlc"
    mas "ApolloOne", id: 1044484672

    # Engineering
    cask "bambu-studio"

    # iOS tooling
    brew "ipatool"
    brew "libimobiledevice"
    cask "impactor"

    # Misc Tools
    cask "balenaetcher"

    # Multimedia tools
    cask "handbrake-app"
    cask "calibre"
    cask "mediainfo"
    # GUI plus CLI: the cask symlinks mkvinfo/mkvmerge/mkvpropedit/mkvextract
    # from the app bundle into PATH (formula therefore Linux-only above)
    cask "mkvtoolnix-app"
    cask "mp3tag"
    cask "obs"

    # Downloader
    cask "jdownloader"

    # Communication
    cask "discord"

    # System
    cask "appcleaner"
    cask "cinebench"
    # for nsusbloader
    brew "libusb"


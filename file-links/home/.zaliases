# Interactive shell helpers. Sourced from .zshrc.

# update-all: comprehensively upgrade everything installed on this machine.
# OS-aware. Per-tool guards skip absent tools. Failures are recorded but do
# not abort the run; an end-of-run report shows what succeeded and what failed.

# __ua_step: run a single update step with banner + status tracking.
# Records OK/FAIL into the parent-scoped __ua_ok / __ua_fail arrays so the
# end-of-run summary can report them. A non-zero exit is captured but does
# not abort the run — partial upgrades are still useful, and forcing an
# abort would mean a single broken plugin manager hides every later step.
__ua_step() {
  local name="$1"
  local cmd="$2"
  print
  print -P "%F{cyan}%B================================================================%b%f"
  print -P "%F{cyan}%B  >>> $name%b%f"
  print -P "%F{cyan}%B================================================================%b%f"
  if eval "$cmd"; then
    __ua_ok+=("$name")
    print
    print -P "%F{green}%B  [OK]%b%f  $name"
  else
    local rc=$?
    __ua_fail+=("$name (exit $rc)")
    print
    print -P "%F{red}%B  [FAIL]%b%f $name (exit $rc)"
  fi
}

# __ua_summary: print the end-of-run report. Succeeded and failed steps are
# listed in separate blocks so a long upgrade run stays scannable. Reads the
# __ua_ok / __ua_fail arrays populated by __ua_step.
__ua_summary() {
  print
  print
  print -P "%B================================================================%b"
  print -P "%B  SUMMARY%b"
  print -P "%B================================================================%b"
  print
  if (( ${#__ua_ok[@]} > 0 )); then
    print -P "%F{green}%BSucceeded (${#__ua_ok[@]}):%b%f"
    for s in $__ua_ok; do
      print -P "  %F{green}[OK]%f   $s"
    done
  fi
  if (( ${#__ua_fail[@]} > 0 )); then
    print
    print -P "%F{red}%BFailed (${#__ua_fail[@]}):%b%f"
    for f in $__ua_fail; do
      print -P "  %F{red}[FAIL]%f $f"
    done
    print
  else
    print
    print -P "%F{green}%BAll updates completed without errors.%b%f"
  fi
  print
}

update-all() {
  __ua_ok=()
  __ua_fail=()

  print -P "%F{cyan}%B::: Detecting environment...%b%f"

  if [[ "$OSTYPE" == "darwin"* ]]; then
    print -P "%F{cyan}%B::: macOS%b%f"
    # --formula keeps step 1 to formulae only: a bare `brew upgrade` would
    # also upgrade non-greedy casks and blur the two steps into each other.
    __ua_step "Homebrew (formulae)"       "brew update && brew upgrade --formula --yes"
    # Upgrading Homebrew's pinentry formula can restore pinentry-curses as
    # the default. Repair the GUI fallback expected by pinentry-touchid.
    if command -v pinentry-touchid >/dev/null 2>&1; then
      __ua_step "GPG pinentry fallback" "pinentry-touchid -check >/dev/null 2>&1 || pinentry-touchid -fix"
    fi
    # --greedy is deliberate policy: in-app auto-updates are disabled where
    # the app allows it, brew is the single update path for casks.
    __ua_step "Homebrew (casks --greedy)" "brew upgrade --cask --greedy --yes"
    if command -v mas >/dev/null 2>&1; then
      # mas 7 requires root privileges for App Store updates; `update` is
      # the canonical command (`upgrade` remains only as an alias).
      __ua_step "Mac App Store (mas)" "sudo mas update"
    fi
  elif command -v dnf >/dev/null 2>&1; then
    print -P "%F{cyan}%B::: Fedora%b%f"
    __ua_step "dnf" "sudo dnf upgrade -y"
    if command -v flatpak >/dev/null 2>&1; then
      __ua_step "Flatpak" "flatpak update -y"
    fi
    if command -v brew >/dev/null 2>&1; then
      __ua_step "Homebrew (formulae)" "brew update && brew upgrade --yes"
    fi
  elif command -v apt-get >/dev/null 2>&1; then
    print -P "%F{cyan}%B::: Debian/Ubuntu%b%f"
    __ua_step "apt" "sudo apt-get update && sudo apt-get upgrade -y"
    if command -v flatpak >/dev/null 2>&1; then
      __ua_step "Flatpak" "flatpak update -y"
    fi
    if command -v brew >/dev/null 2>&1; then
      __ua_step "Homebrew (formulae)" "brew update && brew upgrade --yes"
    fi
  fi

  # mise itself is upgraded by Homebrew above. Upgrade the globally managed
  # tools within their configured compatibility ranges from $HOME, so a
  # project-local mise.toml in the caller's cwd is never touched.
  if command -v mise >/dev/null 2>&1; then
    __ua_step "mise (global tools)" 'mise upgrade --yes --cd "$HOME"'
  fi

  if [[ -n "$ZSH" && -d "$ZSH/tools" ]]; then
    __ua_step "Oh My Zsh" '"$ZSH/tools/upgrade.sh"'
  fi

  # tmux Plugin Manager: prefer Homebrew-installed TPM (Şenol's setup),
  # fall back to manual git-clone install at ~/.tmux/plugins/tpm/. The
  # update_plugins script does not require an active tmux session.
  local tpm_bin
  for tpm_bin in \
    "$(command -v brew >/dev/null 2>&1 && brew --prefix tpm 2>/dev/null)/share/tpm/bin" \
    "$HOME/.tmux/plugins/tpm/bin"; do
    if [[ -x "$tpm_bin/update_plugins" ]]; then
      __ua_step "tmux plugins (TPM)" "'$tpm_bin/update_plugins' all"
      break
    fi
  done

  __ua_summary
}

# List installed Homebrew casks whose metadata declares an in-app updater.
# These are the apps whose own auto-update setting should be disabled so
# update-all remains the single deliberate update path.
brew-auto-updates() {
  if [[ "$OSTYPE" != "darwin"* ]]; then
    print -u2 "brew-auto-updates: Homebrew casks are only used on macOS"
    return 1
  fi
  if ! command -v brew >/dev/null 2>&1; then
    print -u2 "brew-auto-updates: brew is not installed"
    return 1
  fi
  if ! command -v jq >/dev/null 2>&1; then
    print -u2 "brew-auto-updates: jq is required"
    return 1
  fi

  setopt localoptions pipefail
  local casks
  if ! casks="$(brew info --json=v2 --cask --installed |
      jq -r '[.casks[] | select(.auto_updates == true) | .token] | sort[]')"; then
    print -u2 "brew-auto-updates: failed to query Homebrew cask metadata"
    return 1
  fi

  if [[ -n "$casks" ]]; then
    print -r -- "$casks"
  else
    print "No installed casks declare auto_updates."
  fi
}

# _agent_select_harness: choose the harness for one agent session. Codex is
# selected by default; the choice is deliberately per invocation rather than
# persisted as hidden global state.
_agent_select_harness() {
  emulate -L zsh
  setopt localoptions localtraps

  local -a labels=("Codex (default)" "Claude Code")
  local -a commands=(codex claude)
  local selected=1
  local key suffix arrow
  local chosen=""
  local i

  # Use the terminal's alternate screen so redraws do not pollute scrollback.
  print -rn -- $'\e[?1049h\e[?25l'
  {
    while [[ -z "$chosen" ]]; do
      print -rn -- $'\e[2J\e[H'
      print -r -- "Agent $1: select harness"
      print
      for (( i = 1; i <= ${#labels}; i++ )); do
        if (( i == selected )); then
          print -P "%S > $i. ${labels[$i]} %s"
        else
          print -r -- "   $i. ${labels[$i]}"
        fi
      done
      print
      print -r -- "Up/Down or 1/2: select   Enter: start   Esc: exit"

      if ! read -rsk 1 key; then
        chosen="cancel"
        break
      fi

      case "$key" in
        1|2)
          selected="$key"
          ;;
        $'\n'|$'\r'|"")
          chosen="${commands[$selected]}"
          ;;
        $'\e')
          suffix=""
          arrow=""
          if read -rsk 1 -t 0.05 suffix && [[ "$suffix" == "[" ]] &&
              read -rsk 1 -t 0.05 arrow; then
            case "$arrow" in
              A) (( selected = selected == 1 ? ${#labels} : selected - 1 )) ;;
              B) (( selected = selected == ${#labels} ? 1 : selected + 1 )) ;;
            esac
          else
            chosen="cancel"
          fi
          ;;
      esac
    done
  } always {
    print -rn -- $'\e[?25h\e[?1049l'
  }

  [[ "$chosen" == "cancel" ]] && return 1
  REPLY="$chosen"
}

# agent: open one of the personas under ~/agents/<name>/ with the selected
# harness. Codex reads the compiled AGENTS.md; Claude Code reads CLAUDE.md.
# The cd runs in a subshell so the parent shell's cwd is preserved on return.
agent() {
  local AGENTS_DIR="$HOME/agents"
  local name="$1"
  if [[ -z "$name" ]]; then
    print -u2 "usage: agent <name>"
    return 1
  fi
  local dir="$AGENTS_DIR/$name"
  if [[ ! -d "$dir" ]]; then
    print -u2 "no such agent: $name (looked in $dir)"
    return 1
  fi

  local harness
  _agent_select_harness "$name" || return 0
  harness="$REPLY"
  if ! command -v "$harness" >/dev/null 2>&1; then
    print -u2 "agent: selected harness is not installed: $harness"
    return 1
  fi

  ( cd "$dir" && "$harness" )
}

# _agent: zsh completion helper for `agent`. Schema-based filter rather
# than a blacklist: an entry counts as an agent iff it contains a
# persona.md. Adding a new sibling (_shared, tools, scratch, ...) under
# the agents repo therefore needs no change here; if the agent schema
# ever changes, only the filter line moves.
_agent() {
  local AGENTS_DIR="$HOME/agents"
  local d
  local -a agents=()
  for d in "$AGENTS_DIR"/*(N/); do
    [[ -f "$d/persona.md" ]] && agents+=("${d:t}")
  done
  _wanted agents expl 'agent' compadd -a agents
}
compdef _agent agent
